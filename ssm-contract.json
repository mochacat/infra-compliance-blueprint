{
  "version": 1,
  "template": {
    "iam": {
      "apply_order": 1,
      "publishes": [
        "kms-key-arn",
        "ecs-task-exec-role-arn",
        "ecs-task-exec-role-name",
        "ecs-service-role-arn",
        "sagemaker-exec-role-arn",
        "sagemaker-exec-role-name",
        "rds-proxy-role-arn"
      ],
      "consumes": []
    },
    "network": {
      "apply_order": 2,
      "publishes": [
        "vpc-id",
        "app-subnet-ids",
        "data-subnet-ids",
        "default-sg-id"
      ],
      "consumes": [
        "kms-key-arn",
        "ecs-task-exec-role-arn",
        "ecs-service-role-arn"
      ]
    },
    "data": {
      "apply_order": 3,
      "publishes": [
        "pgvector-endpoint",
        "pgvector-reader-endpoint",
        "pgvector-proxy-endpoint",
        "opensearch-endpoint"
      ],
      "consumes": [
        "kms-key-arn",
        "rds-proxy-role-arn",
        "vpc-id",
        "data-subnet-ids",
        "default-sg-id",
        "ecs-task-exec-role-arn",
        "sagemaker-exec-role-arn"
      ]
    },
    "compute": {
      "apply_order": 4,
      "publishes": [
        "ecs-task-exec-role-arn"
      ],
      "consumes": [
        "kms-key-arn",
        "ecs-task-exec-role-arn",
        "ecs-service-role-arn",
        "vpc-id",
        "app-subnet-ids",
        "default-sg-id"
      ]
    },
    "ai": {
      "apply_order": 5,
      "publishes": [
        "sagemaker-exec-role-arn"
      ],
      "consumes": [
        "kms-key-arn",
        "sagemaker-exec-role-arn",
        "sagemaker-exec-role-name",
        "vpc-id",
        "app-subnet-ids",
        "default-sg-id"
      ]
    }
  },
  "environments": {
    "development": [
      {
        "business_unit": "platform",
        "layers": [
          "iam",
          "network",
          "data",
          "compute",
          "ai"
        ]
      },
      {
        "business_unit": "research",
        "layers": [
          "iam",
          "network",
          "data",
          "compute",
          "ai"
        ]
      }
    ],
    "preprod": [
      {
        "business_unit": "platform",
        "layers": [
          "iam",
          "network",
          "data",
          "compute",
          "ai"
        ]
      }
    ],
    "production": [
      {
        "business_unit": "platform",
        "layers": [
          "iam",
          "network",
          "data",
          "compute",
          "ai"
        ]
      },
      {
        "business_unit": "research",
        "layers": [
          "iam",
          "network",
          "data",
          "compute",
          "ai"
        ]
      },
      {
        "business_unit": "data-platform",
        "layers": [
          "iam",
          "network",
          "data",
          "compute",
          "ai"
        ]
      }
    ],
    "sandbox": [
      {
        "business_unit": "platform",
        "layers": [
          "iam",
          "network"
        ]
      }
    ]
  },
  "infrastructure": {
    "network-hub": {
      "network": {
        "publishes": [
          "vpc-id",
          "vpc-cidr",
          "app-subnet-ids",
          "data-subnet-ids",
          "default-sg-id"
        ],
        "consumes": []
      },
      "transit-gateway": {
        "publishes": [
          "transit-gateway-id"
        ],
        "consumes": []
      }
    }
  }
}